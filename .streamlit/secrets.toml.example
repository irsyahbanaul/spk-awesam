name = "Kepala Produksi"
role = "kepala_produksi"
hash = "GANTI_DENGAN_HASH"

[users.jahit]
name = "Kepala Jahit"
role = "kepala_jahit"
hash = "GANTI_DENGAN_HASH"

[users.potong]
name = "Kepala Potong"
