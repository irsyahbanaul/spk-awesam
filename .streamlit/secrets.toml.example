# Salin isi ini ke Streamlit Cloud: App settings -> Secrets (jangan commit secrets.toml asli).
# hash = hasil store._hash("kata-sandi"), jalankan:  python -c "import store;print(store._hash('KATASANDI'))"
[users.admin]
name = "Admin Produksi"
role = "admin_produksi"
hash = "GANTI_DENGAN_HASH"

